{
  "name": "@fits-js/core",
  "version": "0.0.0",
  "description": "Pure TypeScript core: FITS parser, RandomAccessReader, and tile decompression, no runtime dependencies",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/prustic/fits-js.git",
    "directory": "packages/fits-core"
  },
  "homepage": "https://prustic.github.io/fits-js/",
  "bugs": "https://github.com/prustic/fits-js/issues",
  "keywords": [
    "fits",
    "astronomy",
    "parser",
    "typescript",
    "browser"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "test": "node --test dist/**/*.test.js",
    "test:coverage": "c8 --reporter=lcov --reporter=text --reports-dir=coverage --src=src --exclude='dist/**/*.test.js' node --test dist/**/*.test.js",
    "lint": "eslint"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@fits-js/eslint-config": "workspace:*",
    "@fits-js/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:"
  }
}
