{
  "name": "fits-js",
  "version": "0.0.0",
  "private": true,
  "description": "FITS file format implementation for JavaScript runtimes",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "turbo run test:integration",
    "docs:build": "turbo run docs:build",
    "docs:dev": "turbo run docs:dev",
    "blt": "turbo run build lint test",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@fits-js/prettier-config": "workspace:*",
    "c8": "^12.0.0",
    "prettier": "catalog:",
    "turbo": "^2.10.11",
    "typescript": "catalog:"
  },
  "prettier": "@fits-js/prettier-config"
}
